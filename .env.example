# Copy to .env for local runs. In GitHub, add these as Settings > Secrets and variables > Actions > Secrets.
KAGGLE_USERNAME=
KAGGLE_KEY=
GEMINI_API_KEY=          # optional backup lyrics provider (free, no card)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# GITHUB_TOKEN is provided automatically inside GitHub Actions (used for GitHub Models + releases).
